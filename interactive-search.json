
---
layout: null
---
[
  {%- assign games = site.static_files
      | where_exp: "f", "f.path contains '/interactive/'"
      | where_exp: "f", "f.extname == '.html'"
      | sort: "path" -%}

  {%- for f in games -%}

    {%- if f.basename == "index" -%}
      {%- assign title = f.path
          | remove: '/index.html'
          | split: '/'
          | last
          | replace: '-', ' '
          | replace: '_', ' '
          | capitalize -%}
    {%- else -%}
      {%- assign title = f.basename
          | replace: '-', ' '
          | replace: '_', ' '
          | capitalize -%}
    {%- endif -%}

    {%- if title == "Factory lab" -%}
      {%- assign title = "Ladder Logic Engineer – Factory Lab" -%}
    {%- endif -%}

    {
      "title": {{ title | jsonify }},
      "url": {{ f.path | relative_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}

  {%- endfor -%}
]
