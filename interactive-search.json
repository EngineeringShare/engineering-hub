---
layout: null
---
[
{% assign games = site.static_files
  | where_exp: "f", "f.path contains '/interactive/'"
  | where_exp: "f", "f.extname == '.html'"
  | sort: "name" %}

{% for f in games %}
  {
    "title": {{ f.basename | replace: '-', ' ' | replace: '_', ' ' | jsonify }},
    "url": {{ f.path | relative_url | jsonify }},
    "desc": "Interactive engineering activity"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]