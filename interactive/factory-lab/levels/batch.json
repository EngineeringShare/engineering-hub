{
  "title": "Batch of three",
  "level": "Counting · CTU",
  "kind": "batch",
  "brief": "Program a packing station to count passing parts and indicate when a batch of three has been completed.",
  "requirements": [
    "Part Sensor (I0.0) is ON while a passing part is in front of the sensor. Reset Batch (I0.1) is the operator's counter-reset command.",
    "At power-up, the counted number of parts must be zero and Batch Complete (Q0.0) must be OFF.",
    "Count exactly one part whenever Part Sensor (I0.0) changes from OFF to ON. Keeping a part in front of the sensor must not produce additional counts.",
    "Keep Batch Complete (Q0.0) OFF after part 1 and part 2. Turn it ON when the third part is counted, and leave it ON even if further parts pass.",
    "When Reset Batch (I0.1) is ON, clear the count to zero and switch Batch Complete (Q0.0) OFF. Reset takes priority over a simultaneous part signal.",
    "After Reset Batch returns to OFF, a new OFF-to-ON transition at Part Sensor must start counting the next batch."
  ],
  "objective": "Count rising edges and reset a batch.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Part_Sensor",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Reset_Batch",
      "d": false
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Batch_Complete",
      "d": false
    }
  ],
  "hints": [
    "CTU counts FALSE-to-TRUE transitions at CU, not every scan.",
    "Set PV to 3 and configure the reset operand R as Reset_Batch. Use the counter instance Q contact to energise the lamp."
  ],
  "tests": [
    {
      "name": "Three rising edges",
      "steps": [
        {
          "label": "No parts",
          "in": {},
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Part 1 held",
          "in": {
            "%I0.0": 1
          },
          "ms": 1200,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Gap",
          "in": {
            "%I0.0": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Part 2",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Gap",
          "in": {
            "%I0.0": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Part 3",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 1
          }
        },
        {
          "label": "Reset",
          "in": {
            "%I0.1": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Release reset",
          "in": {
            "%I0.1": 0,
            "%I0.0": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "New first part",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        }
      ]
    },
    {
      "name": "Reset dominates count",
      "steps": [
        {
          "label": "Reset held",
          "in": {
            "%I0.1": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Part while reset",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Release reset and sensor",
          "in": {
            "%I0.0": 0,
            "%I0.1": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "New part",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Gap",
          "in": {
            "%I0.0": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Second part",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        }
      ]
    }
  ],
  "id": "batch"
}
