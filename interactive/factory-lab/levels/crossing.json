{
  "title": "Pedestrian crossing",
  "level": "Sequences · Event trigger",
  "kind": "crossing",
  "brief": "Control a simplified pedestrian crossing (training only).",
  "requirements": [
    "Initially step 0: road green and pedestrian red. Wait for Crossing PB to be pressed.",
    "Step 10: road amber, pedestrian red for 3 s. Step 20: road red, pedestrian red for 2 s. Step 30: road red, pedestrian green for 8 s.",
    "Step 40: road red, pedestrian red for 2 s. Step 50: road red + amber, pedestrian red for 2 s. Return to step 0.",
    "Ignore button presses during the sequence. A button held through the end must not start a second sequence; release and press again."
  ],
  "objective": "Trigger and complete a timed sequence.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Crossing_PB",
      "d": false
    }
  ],
