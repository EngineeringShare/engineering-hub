      "n": "Road_Red",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Road_Amber",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "Road_Green",
      "d": false
    },
    {
      "a": "%Q0.3",
      "n": "Ped_Red",
      "d": false
    },
    {
      "a": "%Q0.4",
      "n": "Ped_Green",
      "d": false
    }
  ],
  "mem": [
