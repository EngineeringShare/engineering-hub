        },
        {
          "label": "Clear",
          "in": {
            "%I0.1": 0
          },
          "ms": 200,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Next bottle",
          "in": {
            "%I0.1": 1,
            "%I0.3": 0
