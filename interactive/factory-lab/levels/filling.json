{
  "title": "Automatic filling station",
  "level": "Sequences · Multi-actuator",
  "kind": "filling",
  "brief": "Fill bottles on a conveyor using a retractable nozzle.",
  "requirements": [
    "Start PB (I0.0) starts production. Bottle Present (I0.1) detects the bottle in the filling position; Nozzle Down (I0.2) and Nozzle Up (I0.3) confirm the nozzle position.",
    "Control Conveyor (Q0.0), Nozzle Down Command (Q0.1) and Fill Valve (Q0.2) using the INT Sequence Step (MW10), initially 0.",
    "Step 0: keep Conveyor (Q0.0) and Fill Valve (Q0.2) OFF with Nozzle Down Command (Q0.1) OFF, so the nozzle is raised. When Start PB (I0.0) is pressed, move to step 10.",
    "Step 10: run Conveyor (Q0.0) until Bottle Present (I0.1) is ON. Step 20: stop Conveyor and energise Nozzle Down Command (Q0.1) until Nozzle Down (I0.2) is ON.",
    "Step 30: keep Nozzle Down Command (Q0.1) ON and open Fill Valve (Q0.2) for 5 seconds. Step 40: close Fill Valve and switch Nozzle Down Command OFF; wait until Nozzle Up (I0.3) is ON.",
    "Step 50: run Conveyor (Q0.0) until Bottle Present (I0.1) becomes OFF, then return Sequence Step (MW10) to 10 for the next bottle. Nozzle Down Command must be ON only in steps 20 and 30.",
    "There is no Stop pushbutton input in this exercise; use the CPU Stop control to reset. Step Snapshot (MW12) is provided for optional scan-safe transitions."
  ],
  "objective": "Coordinate motion, sensors and a filling timer.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Start_PB",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Bottle_Present",
      "d": false
    },
    {
      "a": "%I0.2",
      "n": "Nozzle_Down",
      "d": false
    },
    {
      "a": "%I0.3",
      "n": "Nozzle_Up",
      "d": true
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Conveyor",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Nozzle_Down_Command",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "Fill_Valve",
      "d": false
    }
  ],
  "mem": [
    {
      "a": "%MW10",
      "n": "Sequence_Step",
      "d": 0,
      "kind": "INT"
    },
    {
      "a": "%MW12",
      "n": "Step_Snapshot",
      "d": 0,
      "kind": "INT"
    }
  ],
  "tests": [
    {
      "name": "Fill and repeat",
      "steps": [
        {
          "label": "Idle",
          "in": {},
          "ms": 100,
          "expect": {
            "%MW10": 0,
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Feed",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Waiting",
          "in": {
            "%I0.0": 0
          },
          "ms": 2000,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Bottle",
          "in": {
            "%I0.1": 1,
            "%I0.3": 0
          },
          "ms": 100,
          "expect": {
            "%MW10": 20,
            "%Q0.0": false,
            "%Q0.1": true,
            "%Q0.2": false
          }
        },
        {
          "label": "Wait nozzle",
          "in": {},
          "ms": 3000,
          "expect": {
            "%MW10": 20,
            "%Q0.0": false,
            "%Q0.1": true,
            "%Q0.2": false
          }
        },
        {
          "label": "Down",
          "in": {
            "%I0.2": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 30,
            "%Q0.0": false,
            "%Q0.1": true,
            "%Q0.2": true
          }
        },
        {
          "label": "Filling",
          "in": {},
          "ms": 4500,
          "expect": {
            "%MW10": 30,
            "%Q0.0": false,
            "%Q0.1": true,
            "%Q0.2": true
          }
        },
        {
          "label": "Raise",
          "in": {},
          "ms": 700,
          "expect": {
            "%MW10": 40,
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Wait up",
          "in": {
            "%I0.2": 0
          },
          "ms": 500,
          "expect": {
            "%MW10": 40,
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": false
          }
