{
  "title": "Pneumatic press",
  "level": "Timing · TP",
  "kind": "pack",
  "brief": "Create a fixed-length press cycle.",
  "requirements": [
    "Press Request (I0.0) is a momentary command from the operator. Press Extend (Q0.0) controls a spring-return pneumatic press.",
    "Initially, Press Extend (Q0.0) must be OFF. When Press Request (I0.0) changes from OFF to ON, energise Press Extend for exactly 2 seconds.",
    "Once the press cycle begins, keep Press Extend (Q0.0) ON for the full 2 seconds even if the button is released early.",
    "After 2 seconds, switch Press Extend OFF even if Press Request is still being held ON.",
    "A new OFF-to-ON transition of Press Request can start another cycle after completion. Additional transitions during an active cycle must not extend its length."
  ],
  "objective": "Use a pulse timer.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Press_Request",
      "d": false
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Press_Extend",
      "d": false
    }
  ],
  "mem": [],
  "tests": [
    {
      "name": "Hold request",
      "steps": [
        {
          "label": "Start",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 1
          }
        },
        {
          "label": "Before end",
          "in": {},
          "ms": 1800,
          "expect": {
            "%Q0.0": 1
          }
        },
        {
          "label": "End",
          "in": {},
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Still held",
          "in": {},
          "ms": 3000,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "Release",
          "in": {
            "%I0.0": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        },
        {
          "label": "New pulse",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 1
          }
        }
      ]
    },
    {
      "name": "Short press",
      "steps": [
        {
          "label": "Start",
          "in": {
            "%I0.0": 1
          },
          "ms": 100,
          "expect": {
            "%Q0.0": 1
          }
        },
        {
          "label": "Release",
          "in": {
            "%I0.0": 0
          },
          "ms": 1800,
          "expect": {
            "%Q0.0": 1
          }
        },
        {
          "label": "End",
          "in": {},
          "ms": 100,
          "expect": {
            "%Q0.0": 0
          }
        }
      ]
    }
  ],
  "hints": [
    "TP produces a fixed-length pulse after a rising edge.",
    "Use a TP instance with PT T#2s and its Q bit."
  ],
  "id": "pulse"
}
