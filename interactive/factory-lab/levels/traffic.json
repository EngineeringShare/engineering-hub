{
  "title": "Traffic light controller",
  "level": "Sequences · Timed loop",
  "kind": "traffic",
  "brief": "Build a repeating four-step traffic-light sequence.",
  "requirements": [
    "Control three outputs: Red (Q0.0), Amber (Q0.1) and Green (Q0.2). Use the INT memory tag Sequence Step (MW10), initially 10, to determine which stage is active.",
    "Step 10: switch Red (Q0.0) ON, Amber and Green OFF for 5 seconds. Then change Sequence Step (MW10) to 20.",
    "Step 20: switch Red (Q0.0) and Amber (Q0.1) ON, Green OFF for 2 seconds. Then change Sequence Step to 30.",
    "Step 30: switch Green (Q0.2) ON, Red and Amber OFF for 5 seconds. Then change Sequence Step to 40.",
    "Step 40: switch Amber (Q0.1) ON, Red and Green OFF for 2 seconds. Then return Sequence Step (MW10) to 10 and repeat continuously.",
    "The lamps must always match the active step. Green must never be ON at the same time as Red or Amber. Step Snapshot (MW12) is available if you need to avoid multiple step changes during one PLC scan."
  ],
  "objective": "Create a continuously repeating integer sequence.",
  "ins": [],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Red",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Amber",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "Green",
      "d": false
    }
  ],
  "mem": [
    {
      "a": "%MW10",
      "n": "Sequence_Step",
      "d": 10,
      "kind": "INT"
    },
    {
      "a": "%MW12",
      "n": "Step_Snapshot",
      "d": 10,
      "kind": "INT"
    }
  ],
  "tests": [
    {
      "name": "Two cycles",
      "steps": [
        {
          "label": "Red",
          "in": {},
          "ms": 3000,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Red + amber",
          "in": {},
          "ms": 2800,
          "expect": {
            "%MW10": 20,
            "%Q0.0": true,
            "%Q0.1": true,
            "%Q0.2": false
          }
        },
        {
          "label": "Green",
          "in": {},
          "ms": 3000,
          "expect": {
            "%MW10": 30,
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": true
          }
        },
        {
          "label": "Amber",
          "in": {},
          "ms": 4500,
          "expect": {
            "%MW10": 40,
            "%Q0.0": false,
            "%Q0.1": true,
            "%Q0.2": false
          }
        },
        {
          "label": "Red again",
          "in": {},
          "ms": 2000,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "Red + amber again",
          "in": {},
          "ms": 5000,
          "expect": {
            "%MW10": 20,
            "%Q0.0": true,
            "%Q0.1": true,
            "%Q0.2": false
          }
        }
      ]
    },
    {
      "name": "No premature transition",
      "steps": [
        {
          "label": "Before first delay",
          "in": {},
          "ms": 4700,
          "expect": {
            "%MW10": 10,
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false
          }
        },
        {
          "label": "After first delay",
          "in": {},
          "ms": 700,
          "expect": {
            "%MW10": 20,
            "%Q0.0": true,
            "%Q0.1": true,
            "%Q0.2": false
          }
        },
        {
          "label": "Before second delay",
          "in": {},
          "ms": 1300,
          "expect": {
            "%MW10": 20,
            "%Q0.0": true,
            "%Q0.1": true,
            "%Q0.2": false
          }
        }
      ]
    }
  ],
  "hints": [
    "Use comparisons to enable each step timer and each lamp.",
    "Use timer Q AND current step to MOVE the next step. A snapshot of the step can prevent multiple transitions per scan."
  ],
  "sequence": [
    {
      "value": 10,
      "label": "Red"
    },
    {
      "value": 20,
      "label": "Red + amber"
    },
    {
      "value": 30,
      "label": "Green"
    },
    {
      "value": 40,
      "label": "Amber"
    }
  ],
  "id": "traffic"
}
