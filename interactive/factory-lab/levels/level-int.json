{
  "title": "Storage tank monitoring",
  "level": "Integers · Comparisons",
  "kind": "tank",
  "brief": "Display the current fill level using four indicator lamps.",
  "requirements": [
    "Level Percent is an INT input between 0 and 100. Change it using the watch-table slider.",
    "Turn on Low for 0–19, Normal for 20–79, High for 80–94 and Overflow for 95–100.",
    "Exactly one lamp must be ON at any valid level. Update the outputs immediately when the level changes."
  ],
  "objective": "Use integer comparison instructions.",
  "ins": [
    {
      "a": "%IW2",
      "n": "Level_Percent",
      "d": 0,
      "kind": "INT",
      "min": 0,
      "max": 100
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Low",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Normal",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "High",
      "d": false
    },
    {
      "a": "%Q0.3",
      "n": "Overflow",
      "d": false
    }
  ],
  "mem": [],
  "tests": [
    {
      "name": "Level 0",
      "steps": [
        {
          "label": "Set level",
          "in": {
            "%IW2": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false,
            "%Q0.3": false
          }
        }
      ]
    },
