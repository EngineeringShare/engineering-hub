{
  "title": "Storage tank monitoring",
  "level": "Integers · Comparisons",
  "kind": "tank",
  "brief": "Display the current fill level using four indicator lamps.",
  "requirements": [
    "Level Percent (IW2) is an INT input representing the current tank fill percentage from 0 to 100. Use the watch-table slider to change its value.",
    "When Level Percent (IW2) is 0–19, switch Low (Q0.0) ON and all other indicator lamps OFF.",
    "When Level Percent is 20–79, switch Normal (Q0.1) ON and all other lamps OFF.",
    "When Level Percent is 80–94, switch High (Q0.2) ON and all other lamps OFF.",
    "When Level Percent is 95–100, switch Overflow (Q0.3) ON and all other lamps OFF.",
    "For every valid tank level, exactly one of Low (Q0.0), Normal (Q0.1), High (Q0.2) or Overflow (Q0.3) must be ON. Outputs must update as soon as the value changes."
  ],
  "objective": "Use integer comparison instructions.",
  "ins": [
    {
      "a": "%IW2",
      "n": "Level_Percent",
      "d": 0,
      "kind": "INT",
      "min": 0,
      "max": 100
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Low",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Normal",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "High",
      "d": false
    },
    {
      "a": "%Q0.3",
      "n": "Overflow",
      "d": false
    }
  ],
  "mem": [],
  "tests": [
    {
      "name": "Level 0",
      "steps": [
        {
          "label": "Set level",
          "in": {
            "%IW2": 0
          },
          "ms": 100,
          "expect": {
            "%Q0.0": true,
            "%Q0.1": false,
            "%Q0.2": false,
            "%Q0.3": false
          }
        }
      ]
    },
