{
  "title": "Automated production line",
  "level": "Sequences · Capstone",
  "kind": "production",
  "brief": "Automate a five-part manufacturing batch. Use the sequence integer and a second integer for the completed part count.",
  "requirements": [
    "Step 0: all outputs OFF; Start begins a new batch only when Part Count is 0.",
    "Step 10: Feed Conveyor ON until Part At Station is ON. Step 20: Clamp ON until Clamp Closed is ON.",
    "Step 30: keep Clamp ON and Tool ON for 3 seconds. Step 40: keep Clamp ON, Tool OFF; wait for Tool Home.",
    "Step 50: release Clamp and wait for Clamp Open. Step 60: Exit Conveyor ON until Exit Sensor is ON.",
    "Step 70: keep Exit Conveyor ON until Exit Sensor is OFF; then increment Part Count exactly once. Return to 10 if count is below 5, otherwise enter step 80.",
    "Step 80: all actuators OFF, Batch Complete ON. Ignore Start until Reset PB returns the count and step to 0. Reset has no effect during production."
  ],
  "objective": "Combine integer sequencing, timed transitions and count arithmetic.",
