{
  "title": "Reversing motor",
  "level": "Control · Interlocking",
  "kind": "reverse",
  "brief": "Program a motor that can run in either direction using two direction requests and a common drive enable.",
  "requirements": [
    "When Drive Enable is ON and only Forward Request is ON, turn Motor Forward ON and Motor Reverse OFF.",
    "When Drive Enable is ON and only Reverse Request is ON, turn Motor Reverse ON and Motor Forward OFF.",
    "If neither request is ON, both motor outputs must be OFF. If both requests are ON at the same time, both outputs must also be OFF.",
    "Drive Enable must be ON for any movement. Switching it OFF must immediately stop the motor in either direction.",
    "The Forward and Reverse outputs must never be ON together. No latching or timed changeover is required."
  ],
  "objective": "Prevent conflicting motor commands.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Forward_Request",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Reverse_Request",
      "d": false
    },
    {
      "a": "%I0.2",
      "n": "Drive_Enable",
      "d": true
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Motor_Forward",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Motor_Reverse",
      "d": false
    }
  ],
  "hints": [
    "Each direction requires its own request and the common enable.",
    "Add a negated contact of the opposing request in each network. Check both output coils."
  ],
  "tests": [
    {
      "name": "Inputs 0 / 0 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": false,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 0 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": false,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 1 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": true,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 1 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": true,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 0 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": false,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 0 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": false,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": true,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 1 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": true,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": true
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 1 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": true,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    }
  ],
  "id": "reverse"
}
