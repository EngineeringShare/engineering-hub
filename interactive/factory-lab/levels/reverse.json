{
  "title": "Reversing motor",
  "level": "Control · Interlocking",
  "kind": "reverse",
  "brief": "Program a motor that can run in either direction using two direction requests and a common drive enable.",
  "requirements": [
    "Forward Request (I0.0) asks for forward motion; Reverse Request (I0.1) asks for reverse motion. Drive Enable (I0.2) must be ON before the motor can move.",
    "When Drive Enable (I0.2) is ON and only Forward Request (I0.0) is ON, switch Motor Forward (Q0.0) ON and Motor Reverse (Q0.1) OFF.",
    "When Drive Enable is ON and only Reverse Request (I0.1) is ON, switch Motor Reverse (Q0.1) ON and Motor Forward (Q0.0) OFF.",
    "When neither direction is requested, OR both directions are requested simultaneously, both motor outputs must be OFF.",
    "If Drive Enable (I0.2) changes to OFF, switch both outputs OFF immediately. Motor Forward (Q0.0) and Motor Reverse (Q0.1) must never be ON together. Do not add latching or a changeover delay."
  ],
  "objective": "Prevent conflicting motor commands.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Forward_Request",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Reverse_Request",
      "d": false
    },
    {
      "a": "%I0.2",
      "n": "Drive_Enable",
      "d": true
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Motor_Forward",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Motor_Reverse",
      "d": false
    }
  ],
  "hints": [
    "Each direction requires its own request and the common enable.",
    "Add a negated contact of the opposing request in each network. Check both output coils."
  ],
  "tests": [
    {
      "name": "Inputs 0 / 0 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": false,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 0 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": false,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 1 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": true,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 1 / 0",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": true,
            "%I0.2": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 0 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": false,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 0 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": false,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": true,
            "%Q0.1": false
          }
        }
      ]
    },
    {
      "name": "Inputs 0 / 1 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": false,
            "%I0.1": true,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": true
          }
        }
      ]
    },
    {
      "name": "Inputs 1 / 1 / 1",
      "steps": [
        {
          "in": {
            "%I0.0": true,
            "%I0.1": true,
            "%I0.2": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false
          }
        }
      ]
    }
  ],
  "id": "reverse"
}
