{
  "title": "Multi-output control panel",
  "level": "Foundations · Multiple networks",
  "kind": "panel",
  "brief": "Control a motor and its status indicators.",
  "requirements": [
    "Run Request (I0.0) is ON when the operator wants the motor to run. Fault (I0.1) is ON when the machine has a fault.",
    "Motor (Q0.0) must run only when Run Request (I0.0) is ON AND Fault (I0.1) is OFF. A fault must stop the motor immediately.",
    "Running Lamp (Q0.1) must be ON exactly when Motor (Q0.0) is ON. Stopped Lamp (Q0.2) must be ON whenever the motor is OFF.",
    "Fault Lamp (Q0.3) must match Fault (I0.1): ON during a fault and OFF when there is no fault. It is possible for both the Stopped and Fault lamps to be ON together."
  ],
  "objective": "Use several outputs and networks.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Run_Request",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Fault",
      "d": false
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Motor",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Running_Lamp",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "Stopped_Lamp",
      "d": false
    },
    {
      "a": "%Q0.3",
      "n": "Fault_Lamp",
      "d": false
    }
  ],
  "mem": [],
  "tests": [
    {
      "name": "Inputs 00",
      "steps": [
        {
          "label": "Input combination",
          "in": {
            "%I0.0": false,
            "%I0.1": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": true,
            "%Q0.3": false
          }
        }
      ]
    },
    {
      "name": "Inputs 10",
      "steps": [
        {
          "label": "Input combination",
          "in": {
            "%I0.0": true,
            "%I0.1": false
          },
          "ms": 100,
          "expect": {
            "%Q0.0": true,
            "%Q0.1": true,
            "%Q0.2": false,
            "%Q0.3": false
          }
        }
      ]
    },
    {
      "name": "Inputs 01",
      "steps": [
        {
          "label": "Input combination",
          "in": {
            "%I0.0": false,
            "%I0.1": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": true,
            "%Q0.3": true
          }
        }
      ]
    },
    {
      "name": "Inputs 11",
      "steps": [
        {
          "label": "Input combination",
          "in": {
            "%I0.0": true,
            "%I0.1": true
          },
          "ms": 100,
          "expect": {
            "%Q0.0": false,
            "%Q0.1": false,
            "%Q0.2": true,
            "%Q0.3": true
          }
        }
      ]
    }
  ],
  "hints": [
    "Create a separate network per output.",
    "Use the motor output to drive the running and stopped lamps."
  ],
  "id": "panel"
}
