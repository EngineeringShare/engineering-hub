{
  "title": "Machine operating states",
  "level": "Integers · MOVE",
  "kind": "panel",
  "brief": "Store an operator-selected machine state in an INT tag.",
  "requirements": [
    "Stop PB (I0.0), Standby PB (I0.1) and Run PB (I0.2) select the machine's operating state. Store the selection in Machine State (MW10), an INT memory tag.",
    "Machine State (MW10) must initially equal 0 (stopped). Pressing Standby PB (I0.1) sets it to 10; pressing Run PB (I0.2) sets it to 20; pressing Stop PB (I0.0) sets it to 0.",
    "After any button is released, Machine State (MW10) must keep its last selected value until another button is pressed.",
    "If Standby PB and Run PB are ON together, Run takes priority (state 20). Stop PB takes priority over both other buttons (state 0).",
    "Stopped (Q0.0) must be ON only in state 0; Standby (Q0.1) only in state 10; Running (Q0.2) only in state 20. Exactly one indicator should be ON at a time."
  ],
  "objective": "Write and compare retained integer values.",
  "ins": [
    {
      "a": "%I0.0",
      "n": "Stop_PB",
      "d": false
    },
    {
      "a": "%I0.1",
      "n": "Standby_PB",
      "d": false
    },
    {
      "a": "%I0.2",
      "n": "Run_PB",
      "d": false
    }
  ],
  "outs": [
    {
      "a": "%Q0.0",
      "n": "Stopped",
      "d": false
    },
    {
      "a": "%Q0.1",
      "n": "Standby",
      "d": false
    },
    {
      "a": "%Q0.2",
      "n": "Running",
      "d": false
    }
  ],
  "mem": [
    {
      "a": "%MW10",
      "n": "Machine_State",
      "d": 0,
      "kind": "INT"
    }
  ],
  "tests": [
    {
      "name": "Select and retain",
      "steps": [
        {
          "label": "Initial",
          "in": {},
          "ms": 100,
          "expect": {
            "%MW10": 0,
            "%Q0.0": 1,
            "%Q0.1": 0,
            "%Q0.2": 0
          }
        },
        {
          "label": "Standby",
          "in": {
            "%I0.1": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 10,
            "%Q0.0": 0,
            "%Q0.1": 1,
            "%Q0.2": 0
          }
        },
        {
          "label": "Release",
          "in": {
            "%I0.1": 0
          },
          "ms": 100,
          "expect": {
            "%MW10": 10,
            "%Q0.1": 1
          }
        },
        {
          "label": "Run",
          "in": {
            "%I0.2": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 20,
            "%Q0.0": 0,
            "%Q0.1": 0,
            "%Q0.2": 1
          }
        },
        {
          "label": "Release",
          "in": {
            "%I0.2": 0
          },
          "ms": 100,
          "expect": {
            "%MW10": 20,
            "%Q0.2": 1
          }
        },
        {
          "label": "Stop all",
          "in": {
            "%I0.0": 1,
            "%I0.1": 1,
            "%I0.2": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 0,
            "%Q0.0": 1,
            "%Q0.1": 0,
            "%Q0.2": 0
          }
        }
      ]
    },
    {
      "name": "Run priority",
      "steps": [
        {
          "label": "Both",
          "in": {
            "%I0.1": 1,
            "%I0.2": 1
          },
          "ms": 100,
          "expect": {
            "%MW10": 20,
            "%Q0.0": 0,
            "%Q0.1": 0,
            "%Q0.2": 1
          }
        }
      ]
    }
  ],
  "hints": [
    "MOVE writes a number only while its rung is true.",
    "Order the writes by priority, then decode the state with == comparisons."
  ],
  "id": "states"
}
