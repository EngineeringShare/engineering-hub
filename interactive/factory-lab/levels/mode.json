{
  "title": "Automatic / manual control",
  "level": "Control · Mode selection",
  "kind": "conveyor",
  "brief": "Control a conveyor using an automatic/manual selector.",
  "requirements": [
    "Auto Mode ON selects automatic operation; OFF selects manual operation.",
    "In automatic mode, the motor runs only while Part Present is ON. In manual mode, the motor runs only while Manual Jog is ON. Ignore the other demand in each mode.",
    "Guard Closed must be ON regardless of mode. If it is OFF, stop immediately. No memory is required."
  ],
  "objective": "Select between mutually exclusive modes.",
